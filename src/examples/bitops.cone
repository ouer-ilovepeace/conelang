include msvcrt

; cone 0.6 fix1 · 需求 2 —— 位运算 | & ^ ~ << >>
; 编译期（数值 / equ / win.宏）交给 MASM32 表达式求值器，生成 or/and/xor/shl/shr/not；
; 运行期（表达式里有变量）生成对应的 x86 指令。

GENERIC_READ  equ 80000000h
GENERIC_WRITE equ 40000000h
OFLAGS        equ GENERIC_READ | GENERIC_WRITE   ; -> equ (GENERIC_READ or GENERIC_WRITE)
NFLAGS        equ ~0                            ; -> equ not (0)
SHIFTED       equ 1 << 4                        ; -> equ (1 shl 4)
COMBINED      equ (1 | 2) & 3                   ; -> equ ((1 or 2) and 3)

int flg
int g
buf byte[16]

struct Bits{ a int  b int }
Bits bits ={1|2,1<<3}                          ; 初始化项里的编译期位运算

func take(:int,:int,:int)stdcall

def start(){
	; ① 编译期：win 宏 / equ 常量的位或，直接写进 MASM 表达式
	flg=win.GENERIC_READ | win.GENERIC_WRITE
	take(win.GENERIC_READ | win.GENERIC_WRITE,OFLAGS,COMBINED)
	; ② 编译期折叠：纯数字位运算由 cone 折成数值
	g=3|5
	g=0FFh&0Fh
	g=1<<8
	g=~0
	; ③ 运行期：变量参与 -> or / and / xor / shl / shr / not
	flg=flg|g
	flg=flg&0Fh
	flg=flg^0FFh
	flg=flg<<2
	flg=flg>>g
	g=~flg
	; ④ 结构体初始化项 / equ 已在上面
	return 0
}

end start
