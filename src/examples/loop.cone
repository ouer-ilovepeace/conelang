include msvcrt
func msgbox(:int,:int)stdcall

int i
int total
int limit

def start(){
	; 1) 逻辑表达式优先级 非 > 且 > 或；默认无符号比较，直接出 MASM .if
	if !i && i>=0 || limit>100{
		win.crt_printf("logic\n")
	}

	; 2) 你指出的冗余：调用结果直接与立即数比较，不再 push/pop/mov 往返
	if msgbox("eax is \nIDRETRY!",0)>9{
		win.crt_printf("gt9\n")
	}

	; 3) unsigned 是默认情况，显式写等价于不写 -> 仍走 MASM .if（无符号）
	if unsigned i>9{
		win.crt_printf("unsigned gt9\n")
	}

	; 4) signed：MASM .if 做不到有符号比较，走显式 cmp + jle（条件假时跳出）
	if signed i>9{
		win.crt_printf("signed gt9\n")
	}

	; 5) mem-mem 比较：MASM 不支持 cmp mem,mem，用寄存器中转，仍保留 .if
	if i>limit || i==limit{
		win.crt_printf("mem-mem\n")
	}

	; 6) for 有条件 -> .while / .endw；break / continue -> .break / .continue
	i=0
	for i<10{
		i=i+1
		if i==3{
			continue
		}
		if i==8{
			break
		}
		win.crt_printf("loop\n")
	}

	; 7) for 无条件 -> .while 1
	for{
		i=i-1
		if i==0{
			break
		}
	}

	; 8) 条件含函数调用 -> MASM .while 表达不了，降级成显式标签 + jmp
	for msgbox("again",0)>0{
		win.crt_printf("degraded body\n")
		break
	}

	; 9) for unsigned：默认即无符号；但 i 与 limit 都是 mem，循环条件不能提前 mov，降级成显式标签 + jb
	for unsigned i>=limit{
		i=i-1
		continue
	}

	; 10) for signed -> 显式标签 + jl（有符号 <，条件假时跳出）
	for signed i>=limit{
		i=i-1
		break
	}

	; 11) 循环条件里 mem-mem -> 降级（每轮重算，不能在循环外提前 mov）
	for i<limit{
		i=i+1
		break
	}

	return 0
}
end start
