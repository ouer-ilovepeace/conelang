; cone 0.9prelease：立即数统一层回归
; addr xxx / sizeof(xxx) / $ / equ 数值宏 / structtype.member 都是「cone 立即数」，
; 可以出现在赋初值、数组维度、if / match / except 条件、asm{}、asm64{} 等任意立即数场景。
include msvcrt

struct xy{
    x int
    y int
}
struct aligned align{
    a byte
    b int
    w2 word
    d long
}

BASE equ 10
OFFS equ xy.y + BASE                 ; equ 里混用 cone 结构体偏移（= 14）
HALF equ sizeof(aligned) / 4         ; equ 里混用 sizeof（= 6）
hello:"Hello World",0dh,0ah,0        ; 字节数组，sizeof(hello) = 14

xy stxy={}
aligned stalign={}

def start(){
    ; 1) 立即数赋初值：addr / $ / equ / sizeof / Type.member
    int p = addr stxy
    int q = OFFS
    int r = HALF + sizeof(xy)        ; 6 + 8 = 14
    int s = aligned.d                ; 16
    int cur = $

    ; 2) 数组维度用 cone 立即数表达式（sizeof / equ / 算术）
    buf byte[sizeof(aligned)]        ; 24
    grid int[HALF * 2]              ; 12

    ; 3) if / match 分支值、条件里用立即数
    if s == aligned.d{
        p = sizeof(xy)
    }
    match cur{
        sizeof(xy){ p = xy.y }
        $         { p = 0 }
        default   { p = BASE }
    }

    ; 4) asm{} 里 cone 立即数（裸正文 + %NAME 两种写法）
    asm{
        mov eax, xy.y
        mov ebx, sizeof(aligned)
        mov ecx, %OFFS
        mov edx, %sizeof(xy)
        mov esi, $
        mov edi, %aligned.d
    }

    ; 5) asm64{} 里 cone 立即数编码成 x64 机器码
    asm64{
        mov eax, xy.y               ; B8 04 00 00 00
        mov ecx, sizeof(xy)         ; B9 08 00 00 00
        add eax, aligned.b          ; 83 C0 04
        mov edx, OFFS               ; BA 0E 00 00 00（equ 宏也参与）
        syscall
    }

    return 0
}

end start
