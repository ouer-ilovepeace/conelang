include msvcrt

; cone 0.6 fix1 · 需求 4 —— match 分支值可以是任意表达式
; 常量 / 全局内存 / [] / 成员 / 编译期表达式都能直接写进 cmp（零中转）；
; 函数调用 / 比较 / 含变量的算术走求值，用空闲寄存器或栈中转保存判别值，
; 全程不覆盖任何寄存器。

int mode
int table
int hit
arr byte[8]
struct Pt{ x int }
Pt pt

func probe(:int)stdcall

def start(){
	match mode{
		0{ hit=1 }              ; 立即数
		table{ hit=2 }          ; 全局内存值
		[dword arr]{ hit=3 }    ; [] 解引用
		pt.x{ hit=4 }           ; 结构体成员
		1<<3{ hit=5 }           ; 编译期位运算表达式
		2+3{ hit=6 }            ; 可折叠算术
		probe(1){ hit=7 }       ; 函数调用（eax）
		mode==7{ hit=8 }        ; 比较表达式（0/1）
		table+1{ hit=9 }        ; 含变量的算术
		default{ hit=0 }
	}
	return 0
}

end start
